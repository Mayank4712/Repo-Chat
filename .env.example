# Repo Chat configuration
# Copy this file to .env and fill in your values before running.

# OpenRouter API key (required) — get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter model (free tier recommended)
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Embedding model (runs locally, free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=.chroma

# Optional GitHub personal access token (raises API limit from 60 to 5,000 requests/hour)
# Create one at GitHub Settings > Developer settings > Personal access tokens
# (read-only public repository access is enough). Never commit this value.
GITHUB_TOKEN=

# Backend port
PORT=8000
